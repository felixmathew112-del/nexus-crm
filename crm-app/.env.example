# Postgres connection string (Vercel Postgres, Neon, or any Postgres server).
# Vercel's Postgres integrations usually set POSTGRES_URL automatically;
# DATABASE_URL is checked first so you can override it locally.
DATABASE_URL=postgres://user:password@host:5432/dbname

# HMAC secret used to sign session cookies. Generate one with:
#   openssl rand -hex 32
# Required in production - without it, sessions fall back to a hardcoded
# dev-only secret (see src/lib/session.ts) that anyone could forge.
SESSION_SECRET=

# Shared secret checked by /api/cron/stale-deals so it can only be triggered
# by the scheduler, not anyone who finds the URL. Generate the same way as
# SESSION_SECRET. If unset, the endpoint is left unauthenticated (fine for
# local dev, not for a real deployment).
CRON_SECRET=
